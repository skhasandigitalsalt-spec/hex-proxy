{
  "name": "hex-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply hex-credits --local",
    "db:migrate:remote": "wrangler d1 migrations apply hex-credits --remote"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.40.0"
  }
}
